# Copy to .env (gitignored); `just` loads it automatically.

# Storage account holding the config blobs:
#   terraform -chdir=infra output -raw storage_account_name   (needs the remote state)
#   az storage account list --query "[].name" -o tsv
SPACESTATE_STORAGE_ACCOUNT=

# Optional: editor for `just edit` (defaults to vi).
# EDITOR=code --wait
